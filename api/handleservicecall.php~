<? 
$type = $method=="uploadNewInstall"?"ni":"sc";
$schoolname = array_shift( explode( "\n", $_POST["schoolname" ] ) );
$newid = db_query_insert_id( "insert into appuploads ( dateuploaded, type, uploader, dateinupload,esi_repname, name, version, schoolname ) values ( now(), '$type', '". mysql_escape_string( $_POST["uploader"] ). "', '$signdate', '". mysql_escape_string( $_POST["esr_name"] ). "', '". mysql_escape_string( $_POST["name"] ). "', '". mysql_escape_string( $_POST["version"] ). "', '". mysql_escape_string( $schoolname ). "' )" );

$scdate = "$signdate";
$theservicecallid = "";

foreach( $data as $key=>$value )
{
    if( $key == "id" ) $schoolid = $value;
    if( $key == "serviceid" ) $theservicecallid = $value;
    if( $key == "servicecallid" )
    {
            // check if this service call is already attached to an uploaded SC
        $already = db_query_first_cell( "select uploadid from appuploaddata where name = 'servicecallid' and value = '$theservicecallid'" );
        if( $already )
        {
                // get the companyid, which is the only important thing, from the other, already existing drill
            $comid = db_query_first_cell( "select value from appuploaddata where uploadid = '$already' and name = 'id' " );
            $newsc = db_query_insert_id( "insert into servicecall ( companyid ) values ( '$comid' )" );
            $value = $newsc; 
        }
        
        $theservicecallid = $value;
    }
    if( $key == "servicedata" || $key == "installdata" )
    {
        foreach( $value as $num=>$singledata )
        {
            $scid = db_query_insert_id( "insert into scuploaddata( uploadid,serial ) values ( '$newid', '" . mysql_escape_string( $singledata->serial_number ). "' )" );
            foreach( $singledata as $skey=>$sval )
                {
                    if( $skey == "adultpadA"|| $skey == "adultpadB"|| $skey == "pediatric" )
                    {
                        foreach( $sval as $another=>$aval )
                        {
                            db_query( "insert into scuploaddetail ( dataid, name, value ) values ( '$scid', '{$skey}_{$another}', '". mysql_escape_string( $aval ) . "' )");
                        }
                    }
                    else
                    {
                        db_query( "insert into scuploaddetail ( dataid, name, value ) values ( '$scid', '{$skey}', '". mysql_escape_string( $sval ) . "' )");
                    }
                    
                }
        }
    }
    else
    {
        db_query( "insert into appuploaddata( uploadid,name, value ) values ( '$newid', '$key', '" . mysql_escape_string( $value )."' )" );
    }
}

if( !$_FILES["media_file"]["tmp_name"] )
{
	mail( "cox@vireo.org", "no files for uploaded service call ($newid)?", "id: $newid, \n" . print_r( $_FILES, true ) . "\n" . print_r( $_POST, true ), "From: info@emergencyskills.com" );
}

db_query( "update appuploads set schoolid = '$schoolid' where id = '$newid'" );
