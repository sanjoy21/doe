body,td,th {
	font-family: Verdana, Arial, Helvetica, sans-serif;
	font-size: 11px;
	color: #333333;
}
a:link {
	color: #003366;
	text-decoration: underline;
}
a:visited {
	text-decoration: underline;
	color: #003366;
}
a:hover {
	text-decoration: none;
	color: #003366;
}
a:active {
